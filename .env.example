# =============================================================================
# crawlspark.ai — Environment Variables
# Copy to .env locally, or add in Vercel → Settings → Environment Variables
# Redeploy after changing vars on Vercel.
# Full setup guide: INTEGRATIONS.md
# =============================================================================

# --- Required (app won't auth without these) ---
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
AUTH_SECRET=your-secret-here
AUTH_URL=https://crawlspark.ai

# --- Admin seed (npm run db:seed / vercel-build) ---
ADMIN_EMAIL=admin@crawlspark.ai
ADMIN_PASSWORD=change-this-strong-password
ADMIN_NAME=Admin

# --- AI copy + images (set one or both) ---
# OpenAI: GPT-4o mini (copy) + DALL·E 3 (images)
OPENAI_API_KEY=
# xAI: Grok (copy + images). If both set, xAI is preferred for copy.
XAI_API_KEY=

# --- X / Twitter ---
# OAuth 2.0 USER access token with tweet.write scope (not app-only bearer)
TWITTER_ACCESS_TOKEN=
# Legacy alias — use TWITTER_ACCESS_TOKEN for posting
TWITTER_BEARER_TOKEN=

# --- LinkedIn ---
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:YOUR_MEMBER_ID

# --- Facebook Page ---
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# --- Instagram Business (via Meta Graph API) ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# --- Pinterest ---
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# --- Crypto Billing (USDC on Base recommended for low fees) ---
# The wallet address that will receive USDC payments.
# IMPORTANT: This must be a wallet you control. Do not use an exchange deposit address.
NEXT_PUBLIC_CRYPTO_RECEIVER_ADDRESS=0xYourBaseOrEthWalletAddressHere

# Default network for display and instructions. Supported in UI: "base", "ethereum"
NEXT_PUBLIC_CRYPTO_NETWORK=base

# Pricing in USDC (monthly). Change as needed; these are shown to users.
CRYPTO_PRICE_PRO=29
CRYPTO_PRICE_ENTERPRISE=99
