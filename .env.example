# =============================================================================
# crawlspark.ai — Environment Variables
# Copy to .env locally, or add in Vercel → Settings → Environment Variables
# Redeploy after changing vars on Vercel.
# Full setup guide: INTEGRATIONS.md
# =============================================================================

# --- Required (app won't auth without these) ---
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
AUTH_SECRET=your-secret-here
AUTH_URL=https://crawlspark.ai

# --- Admin seed (npm run db:seed / vercel-build) ---
ADMIN_EMAIL=admin@crawlspark.ai
ADMIN_PASSWORD=change-this-strong-password
ADMIN_NAME=Admin

# --- AI copy + images (set one or both) ---
# OpenAI: GPT-4o mini (copy) + DALL·E 3 (images)
OPENAI_API_KEY=
# xAI: Grok (copy + images). If both set, xAI is preferred for copy.
XAI_API_KEY=
# Replicate: AI video ads (Seedance text-to-video) in Content Studio
REPLICATE_API_TOKEN=

# --- X / Twitter ---
# Recommended for global fallback: a user-level access token with tweet.write scope
# (Generate in Twitter Developer Portal under your App → Keys and tokens → "Generate Access Token and Secret" or via OAuth flow)
TWITTER_ACCESS_TOKEN=

# App-only Bearer Token (AAAA... from developer portal).
# Supported as fallback but **cannot post tweets** (only some read operations).
# If only this is set, publishing will fall back to share links with a clear message.
# Prefer TWITTER_ACCESS_TOKEN or (best) per-site OAuth "Connect with X".
TWITTER_BEARER_TOKEN=

# For full OAuth 2.0 user authentication flow ("Connect with X" buttons per site)
# Get these from your Twitter Developer App → Keys and tokens
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- LinkedIn ---
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:YOUR_MEMBER_ID

# --- Facebook Page ---
# Option A (global): long-lived Page access token + Page ID
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
# Option B (per-site OAuth): Meta app credentials for "Connect with Facebook"
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Instagram Business (via Meta Graph API) ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# --- Pinterest ---
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# --- Crypto Billing (XRP on XRPL — default) ---
# XRP Ledger address that receives subscription payments.
NEXT_PUBLIC_CRYPTO_RECEIVER_ADDRESS=rNBYkS1ZHSekLLoFHGAvbTtgAaXXi9Fm71

# Network + currency shown in billing UI. Use "xrp" + "XRP" (default), or "base"/"ethereum" + "USDC".
NEXT_PUBLIC_CRYPTO_NETWORK=xrp
NEXT_PUBLIC_CRYPTO_CURRENCY=XRP

# Monthly plan prices (in XRP by default).
CRYPTO_PRICE_PRO=29
CRYPTO_PRICE_ENTERPRISE=99
