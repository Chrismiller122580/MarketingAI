# =============================================================================
# crawlspark.ai — Environment Variables
# Copy to .env locally, or add in Vercel → Settings → Environment Variables
# Redeploy after changing vars on Vercel.
# Full setup guide: INTEGRATIONS.md
# =============================================================================

# --- Required (app won't auth without these) ---
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
AUTH_SECRET=your-secret-here
# Local dev: http://localhost:3000 — Production: https://www.crawlspark.ai
AUTH_URL=http://localhost:3000
AUTH_URL_LOCAL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Admin seed (npm run db:seed / vercel-build) ---
ADMIN_EMAIL=chrismiller122580@gmail.com
ADMIN_PASSWORD=your-secure-password-here
ADMIN_NAME=Chris

# --- Visual editor image storage (Vercel Blob) ---
# vercel.com → Storage → Blob → Create store → copy token
BLOB_READ_WRITE_TOKEN=

# --- AI copy + images (set one or both) ---
# OpenAI: GPT-4o mini (copy) + DALL·E 3 (images)
OPENAI_API_KEY=
# Optional: defaults to gpt-image-1 (dall-e-3 is deprecated)
OPENAI_IMAGE_MODEL=gpt-image-1
# xAI: Grok (copy + images). If both set, xAI is preferred for copy.
XAI_API_KEY=
# Replicate: AI video ads (Seedance) + ViraForge motion clips (Kling i2v, SadTalker)
REPLICATE_API_TOKEN=
# ElevenLabs: ViraForge talking clips (TTS voice for lip-sync)
ELEVENLABS_API_KEY=
# Optional: override default ElevenLabs voice for influencers
ELEVENLABS_VOICE_ID=

# --- X / Twitter ---
# Recommended for global fallback: a user-level access token with tweet.write scope
# (Generate in Twitter Developer Portal under your App → Keys and tokens → "Generate Access Token and Secret" or via OAuth flow)
TWITTER_ACCESS_TOKEN=

# App-only Bearer Token (AAAA... from developer portal).
# Supported as fallback but **cannot post tweets** (only some read operations).
# If only this is set, publishing will fall back to share links with a clear message.
# Prefer TWITTER_ACCESS_TOKEN or (best) per-site OAuth "Connect with X".
TWITTER_BEARER_TOKEN=

# For full OAuth 2.0 user authentication flow ("Connect with X" buttons per site)
# Get these from your Twitter Developer App → Keys and tokens
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- LinkedIn ---
# Option A (global): manual access token + author URN
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:YOUR_MEMBER_ID
# Option B (per-site OAuth): "Connect with LinkedIn" on a loaded site
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Facebook Page ---
# Option A (global): long-lived Page access token + Page ID
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
# Option B (per-site OAuth): Meta / Threads app credentials for "Connect with Facebook"
# (Threads App ID in Meta Developer Console = FACEBOOK_CLIENT_ID)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Facebook Login for Business — Configuration ID from App Dashboard → Facebook Login → Configurations
FACEBOOK_LOGIN_CONFIG_ID=

# --- Meta Marketing API (App Review / ads tier testing only) ---
# System User or user token from THIS app with ads_read (+ ads_management for writes)
# META_ADS_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID=act_1234567890

# --- Instagram Business (via Meta Graph API) ---
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# --- Pinterest ---
# Option A (global): access token + board ID
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
# Option B (per-site OAuth): "Connect Pinterest" on a loaded site
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# --- Email (Resend) ---
# 1. resend.com → API Keys → Create
# 2. resend.com/domains → add crawlspark.ai (or your domain) → verify DNS
# 3. Test only (no domain): EMAIL_FROM=CrawlSpark <onboarding@resend.dev>
RESEND_API_KEY=re_...
EMAIL_FROM=CrawlSpark <hello@crawlspark.ai>
EMAIL_DEFAULT_TO=

# --- Scheduled crons (Vercel) ---
# publish-scheduled: daily 9:00 UTC · sync-metrics: every 6 hours
# Generate with: openssl rand -base64 32
CRON_SECRET=

# --- EVM payment auto-verify (optional, for Base/Ethereum USDC) ---
ETHERSCAN_API_KEY=

# --- XRPL server for payment verification (optional) ---
XRPL_SERVER=wss://xrplcluster.com

# --- Crypto Billing (XRP on XRPL — default) ---
# XRP Ledger address that receives subscription payments.
NEXT_PUBLIC_CRYPTO_RECEIVER_ADDRESS=rNBYkS1ZHSekLLoFHGAvbTtgAaXXi9Fm71

# Network + currency shown in billing UI. Use "xrp" + "XRP" (default), or "base"/"ethereum" + "USDC".
NEXT_PUBLIC_CRYPTO_NETWORK=xrp
NEXT_PUBLIC_CRYPTO_CURRENCY=XRP

# Monthly plan prices (in XRP by default).
CRYPTO_PRICE_PRO=29
CRYPTO_PRICE_ENTERPRISE=99

# --- Stripe Billing (recurring subscriptions) ---
# Dashboard: stripe.com → Developers → API keys + Products → Prices
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring monthly Price IDs from Stripe Products (Pro / Enterprise)
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...
STRIPE_PRICE_ENTERPRISE_PLUS=price_...
# Display amounts (should match Stripe Price amounts)
STRIPE_PRICE_PRO_AMOUNT=29
STRIPE_PRICE_ENTERPRISE_AMOUNT=99
STRIPE_PRICE_ENTERPRISE_PLUS_AMOUNT=149
CRYPTO_PRICE_ENTERPRISE_PLUS=149
