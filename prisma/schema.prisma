generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String         @id @default(cuid())
  name               String?
  email              String         @unique
  role               String         @default("user")
  plan               String         @default("free")
  subscriptionStatus String?
  subscriptionEndsAt DateTime?
  emailVerified      DateTime?
  passwordHash       String?
  image              String?
  accounts           Account[]
  sessions           Session[]
  sites              Site[]
  posts              Post[]
  packs              CampaignPack[]
  settings           UserSettings?
  payments           Payment[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Site {
  id                 String                 @id @default(cuid())
  userId             String
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain             String
  crawledAt          DateTime
  brand              Json
  pages              Json
  images             Json
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  posts              Post[]
  socialConnections  SiteSocialConnection[]

  @@unique([userId, domain])
}

model SiteSocialConnection {
  id             String    @id @default(cuid())
  siteId         String
  site           Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  platform       String    // "twitter", "linkedin", "facebook", "instagram", "pinterest"
  accessToken    String    @db.Text
  refreshToken   String?   @db.Text
  expiresAt      DateTime?
  accountId      String?   // e.g. Facebook Page ID, LinkedIn URN
  providerUserId String?   // e.g. Facebook app-scoped user ID (ASID)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([siteId, platform])
}

model DataDeletionRequest {
  id               String    @id @default(cuid())
  facebookUserId   String
  confirmationCode String    @unique
  status           String    @default("pending") // pending, completed, failed
  errorMessage     String?
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  @@index([facebookUserId])
}

model Post {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId         String?
  site           Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  text           String    @db.Text
  hashtags       String[]
  cta            String
  platform       String
  contentType    String
  image          Json
  insights       String[]
  sourcePage     String?
  characterCount Int
  scheduledFor   String?
  publishStatus  String    @default("draft")
  publishedAt    DateTime?
  publishUrl     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model CampaignPack {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  posts     Json
  createdAt DateTime @default(now())
}

model UserSettings {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandVoice       String   @db.Text
  targetAudience   String
  defaultPlatforms String[]
  includeHashtags  Boolean  @default(true)
  emojiStyle       String   @default("light")
  preferAiImages   Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

model Payment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        String
  amount      Decimal   @db.Decimal(10, 2)
  currency    String    @default("USDC")
  network     String    @default("base")
  txHash      String?
  reference   String    @unique
  status      String    @default("pending") // pending, confirmed, rejected
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
}
