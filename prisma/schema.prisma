generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String         @id @default(cuid())
  name                 String?
  email                String         @unique
  role                 String         @default("user")
  plan                 String         @default("free")
  subscriptionStatus   String?
  subscriptionEndsAt   DateTime?
  stripeCustomerId     String?        @unique
  stripeSubscriptionId String?        @unique
  emailVerified      DateTime?
  passwordHash       String?
  image              String?
  accounts           Account[]
  sessions           Session[]
  sites              Site[]
  posts              Post[]
  packs              CampaignPack[]
  settings           UserSettings?
  payments           Payment[]
  influencers        Influencer[]
  productFacts       ProductFacts[]
  creatorEvents      CreatorLearningEvent[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Site {
  id                 String                 @id @default(cuid())
  userId             String
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain             String
  crawledAt          DateTime
  brand              Json
  pages              Json
  images             Json
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  posts              Post[]
  socialConnections  SiteSocialConnection[]

  @@unique([userId, domain])
}

model SiteSocialConnection {
  id             String    @id @default(cuid())
  siteId         String
  site           Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  platform       String    // "twitter", "linkedin", "facebook", "instagram", "pinterest"
  accessToken    String    @db.Text
  refreshToken   String?   @db.Text
  expiresAt      DateTime?
  accountId      String?   // e.g. Facebook Page ID, LinkedIn URN
  providerUserId String?   // e.g. Facebook app-scoped user ID (ASID)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([siteId, platform])
}

model DataDeletionRequest {
  id               String    @id @default(cuid())
  facebookUserId   String
  confirmationCode String    @unique
  status           String    @default("pending") // pending, completed, failed
  errorMessage     String?
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  @@index([facebookUserId])
}

model Post {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId         String?
  site           Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  influencerId   String?
  influencer     Influencer? @relation(fields: [influencerId], references: [id], onDelete: SetNull)
  text           String    @db.Text
  hashtags       String[]
  cta            String
  platform       String
  contentType    String
  image          Json
  insights       String[]
  sourcePage     String?
  characterCount Int
  scheduledFor   String?
  publishStatus  String    @default("draft")
  publishedAt    DateTime?
  publishUrl       String?
  externalPostId   String?
  performance      Json?
  aiVariants       Json?
  selectedProvider String?
  originalText     String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model CampaignPack {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  posts     Json
  createdAt DateTime @default(now())
}

model UserSettings {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandVoice       String   @db.Text
  targetAudience   String
  defaultPlatforms String[]
  includeHashtags  Boolean  @default(true)
  emojiStyle       String   @default("light")
  preferAiImages     Boolean  @default(false)
  promptPreferences  Json?
  creatorPreferences Json?
  activeSiteDomain   String?
  activeSiteChosen   Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

model Influencer {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName    String
  handle         String
  persona        Json
  memory         Json?
  assets         Json?
  productFactsId String?
  productFacts   ProductFacts? @relation(fields: [productFactsId], references: [id], onDelete: SetNull)
  learningEvents CreatorLearningEvent[]
  posts          Post[]
  renders        InfluencerRender[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, handle])
  @@index([userId])
}

model InfluencerRender {
  id           String     @id @default(cuid())
  userId       String
  influencerId String
  influencer   Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  type         String
  status       String
  url          String?    @db.Text
  voiceUrl     String?    @db.Text
  motionType   String?
  script       String?    @db.Text
  voiceId      String?
  provider     String?
  predictionId String?
  prompt       String?    @db.Text
  metadata     Json?
  isActive     Boolean    @default(false)
  error        String?
  createdAt    DateTime   @default(now())

  @@index([influencerId, type, createdAt])
  @@index([userId])
}

model ProductFacts {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  price       String
  features    String[]
  location    String?
  hours       String?
  ingredients String[]
  influencers Influencer[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
}

model CreatorLearningEvent {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  influencerId String?
  influencer   Influencer? @relation(fields: [influencerId], references: [id], onDelete: SetNull)
  eventType    String
  payload      Json
  createdAt    DateTime    @default(now())

  @@index([userId])
  @@index([influencerId])
}

model Payment {
  id                      String    @id @default(cuid())
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider                String    @default("crypto") // crypto, stripe
  plan                    String
  amount                  Decimal   @db.Decimal(10, 2)
  currency                String    @default("USDC")
  network                 String    @default("base")
  txHash                  String?
  reference               String?   @unique
  stripeCheckoutSessionId String?
  stripeInvoiceId         String?   @unique
  stripeSubscriptionId    String?
  status                  String    @default("pending") // pending, confirmed, rejected
  confirmedAt             DateTime?
  createdAt               DateTime  @default(now())
}
